          <li><i data-lucide="check" aria-hidden="true"></i>Animaciones suaves</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Galería o proyectos</li>
          <li><i data-lucide="check" aria-hidden="true"></i>3 rondas de ajustes</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Guía de edición PDF</li>
        </ul>
        <a class="btn btn-wa" data-wa="Hola, quiero la Landing elaborada (S/ 250)." href="#contacto">Quiero este plan</a>
      </div>
      <div class="plan rv" style="--i:2">
        <h3>Catálogo · Menú · Microapp</h3>
        <div class="price sm">A cotizar</div>
        <p>Según lo que necesite tu negocio</p>
        <hr>
        <ul class="ck">
          <li><i data-lucide="check" aria-hidden="true"></i>Panel editable</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Pedidos por WhatsApp</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Capacitación incluida</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Mantenimiento opcional</li>
