<section id="faq" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div>
      <p class="eyebrow">Preguntas</p>
      <h2 id="faq-title">Resolvemos tus dudas antes de empezar</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item">
        <h3 class="faq-q"><button class="faq-btn" type="button" id="faq-btn-1" aria-expanded="true" aria-controls="faq-panel-1"><span>¿Cuánto tarda mi página?</span><span class="faq-icon" aria-hidden="true"><i data-lucide="plus"></i></span></button></h3>
        <div class="faq-panel" id="faq-panel-1" role="region" aria-labelledby="faq-btn-1" data-open="true"><div class="faq-inner"><p>Entre 3 y 7 días, según el tamaño. Te doy una fecha al cotizar.</p></div></div>
      </div>
      <div class="faq-item">
        <h3 class="faq-q"><button class="faq-btn" type="button" id="faq-btn-2" aria-expanded="false" aria-controls="faq-panel-2"><span>¿Puedo editar precios y productos yo mismo?</span><span class="faq-icon" aria-hidden="true"><i data-lucide="plus"></i></span></button></h3>
        <div class="faq-panel" id="faq-panel-2" role="region" aria-labelledby="faq-btn-2" data-open="false" aria-hidden="true"><div class="faq-inner"><p>Sí. Usas una hoja simple y la página se actualiza sola. Te enseño cómo en la entrega.</p></div></div>
      </div>
      <div class="faq-item">
        <h3 class="faq-q"><button class="faq-btn" type="button" id="faq-btn-3" aria-expanded="false" aria-controls="faq-panel-3"><span>¿El dominio queda a mi nombre?</span><span class="faq-icon" aria-hidden="true"><i data-lucide="plus"></i></span></button></h3>
        <div class="faq-panel" id="faq-panel-3" role="region" aria-labelledby="faq-btn-3" data-open="false" aria-hidden="true"><div class="faq-inner"><p>Sí. El dominio y el hosting se registran con tus datos.</p></div></div>
      </div>
      <div class="faq-item">
        <h3 class="faq-q"><button class="faq-btn" type="button" id="faq-btn-4" aria-expanded="false" aria-controls="faq-panel-4"><span>¿Cómo y cuándo pago?</span><span class="faq-icon" aria-hidden="true"><i data-lucide="plus"></i></span></button></h3>
        <div class="faq-panel" id="faq-panel-4" role="region" aria-labelledby="faq-btn-4" data-open="false" aria-hidden="true"><div class="faq-inner"><p>Lo acordamos por WhatsApp al cotizar. Tú eliges la forma de pago que te quede mejor.</p></div></div>
      </div>
    </div>
  </div>
</section>

<section id="contacto" style="padding-top:0" aria-labelledby="contacto-title">
  <div class="wrap">
    <div class="cta">
      <div>
        <p class="eyebrow">Contrata por WhatsApp</p>
        <h2 id="contacto-title">Cuéntame tu idea. Te respondo hoy.</h2>
        <p class="sub">Cotización gratis y sin compromiso. Tu mensaje llega directo a mi WhatsApp.</p>
        <ul class="ck">
          <li><i data-lucide="check" aria-hidden="true"></i>Respuesta en menos de 24 horas</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Cotización gratis</li>
          <li><i data-lucide="check" aria-hidden="true"></i>Atención personalizada</li>
        </ul>
      </div>
      <form id="form" novalidate>
        <div class="field">
          <label for="f-name">Tu nombre</label>
          <input id="f-name" name="nombre" type="text" autocomplete="name" placeholder="Ej. Carlos" aria-describedby="err-name" aria-invalid="false">
          <p class="err" id="err-name" role="alert"></p>
        </div>
        <div class="field">
          <label for="f-type">Tipo de negocio</label>
          <select id="f-type" name="tipo" aria-describedby="err-type" aria-invalid="false">
            <option value="" disabled selected>Selecciona tu tipo de negocio</option>
            <optgroup label="Comida y bebida">
              <option>Restaurante / Cevichería</option>
              <option>Cafetería / Panadería / Pastelería</option>
              <option>Bar / Discoteca</option>
              <option>Comida rápida / Delivery</option>
            </optgroup>
            <optgroup label="Comercio">
              <option>Bodega / Minimarket</option>
              <option>Tienda de ropa y moda</option>
              <option>Ferretería / Construcción</option>
              <option>Venta de agua / Distribuidora</option>
              <option>Mercado / Puesto</option>
              <option>Joyería / Accesorios</option>
              <option>Tienda online</option>
            </optgroup>
            <optgroup label="Belleza y salud">
              <option>Peluquería / Barbería / Spa</option>
              <option>Consultorio / Clínica</option>
              <option>Gimnasio / Entrenador</option>
              <option>Psicología / Bienestar</option>
            </optgroup>
            <optgroup label="Servicios">
              <option>Educación / Academia</option>
              <option>Inmobiliaria</option>
              <option>Taller mecánico / Automotriz</option>
              <option>Servicios profesionales (abogado, contador, etc.)</option>
              <option>Fotografía / Eventos</option>
              <option>Transporte / Mudanzas</option>
            </optgroup>
            <optgroup label="Otros">
              <option>Emprendimiento personal</option>
              <option>Arte / Música</option>
              <option>Otro</option>
            </optgroup>
          </select>
          <p class="err" id="err-type" role="alert"></p>
        </div>
        <div class="field field-other" id="other-field" data-open="false" aria-hidden="true">
          <div class="other-inner" id="other-inner">
            <label for="f-other">¿Cuál es tu negocio?</label>
            <input id="f-other" name="otro" type="text" placeholder="Ej. Taller de bicicletas" aria-describedby="err-other" aria-invalid="false">
            <p class="err" id="err-other" role="alert"></p>
          </div>
        </div>
        <div class="field">
          <label for="f-need">¿Qué necesitas?</label>
          <textarea id="f-need" name="necesidad" rows="2" placeholder="Landing, catálogo, menú QR…"></textarea>
        </div>
        <button class="btn btn-wa" type="submit">Enviar por WhatsApp <i data-lucide="arrow-right" aria-hidden="true"></i></button>
        <small>Se abre WhatsApp con tu mensaje listo.</small>
      </form>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <div class="fgrid">
      <div>
        <div class="logo"><img src="img/logo/alisto-dark.png" width="81" height="26" loading="lazy" decoding="async" alt="alisto"></div>
        <p>Servicios digitales para negocios en Perú y Latinoamérica.</p>
      </div>
      <div class="cols">
        <div>
          <h5>Servicios</h5>
          <a href="#servicios">Landing page</a>
          <a href="#servicios">Catálogo digital</a>
          <a href="#servicios">Menú QR</a>
          <a href="#servicios">Microapps</a>
        </div>
        <div>
          <h5>Sitio</h5>
          <a href="#proyectos">Proyectos</a>
          <a href="#proceso">Proceso</a>
          <a href="#precios">Precios</a>
          <a href="#faq">Preguntas</a>
        </div>
        <div>
          <h5>Contacto</h5>
          <a data-wa="Hola, quiero más información." href="#contacto">WhatsApp</a>
          <a id="ig" href="https://instagram.com/" target="_blank" rel="noopener">Instagram</a>
          <a id="tt" href="https://tiktok.com/" target="_blank" rel="noopener">TikTok</a>
        </div>
      </div>
    </div>
    <p class="copy">© 2026 alisto. Todos los derechos reservados.</p>
  </div>
</footer>

<a class="fab" id="fab" data-wa="Hola, quiero cotizar un servicio digital." href="#contacto" target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
  <svg aria-hidden="true"><use href="#wa-icon"></use></svg>
  <span class="fab-label">Escríbeme</span>
</a>

</a>

<script src="https://cdn.jsdelivr.net/npm/lucide@1.65.0/dist/umd/lucide.min.js" defer></script>
<script>
/* ====== CONFIGURA AQUÍ ====== */
const WA_NUMBER = "906940777"; // tu número con código de país, sin + ni espacios
const PROJECTS = [
  {id:"mercado", name:"Catálogo con carrito", title:"Mercado Guacaipuro", url:"https://mercado-guacaipuro.vercel.app", tags:["Catálogo","WhatsApp","Editable"],
   problem:"Pedidos desordenados por chat y precios que cambian cada semana.", solution:"5 combos con carrito, delivery o retiro y pedido directo a WhatsApp.", result:"El dueño actualiza precios solo, sin pagar cada cambio."},
  {id:"ropa", name:"Landing page / Catálogo", title:"ARM Marca de ropa", url:"https://armshop-chi.vercel.app", tags:["Ropa","WhatsApp","Editable"],
   problem:"Una marca de ropa sin presencia web clara y catálogo ordenado.", solution:"Una landing con catálogo de productos, tallas y pedido directo a WhatsApp.", result:"Los clientes navegan el catálogo y realizan pedidos fácilmente."},
  {id:"menu", name:"Menú interactivo", title:"Menú QR para restaurantes", url:"https://TU-DEMO-MENU.vercel.app", tags:["Menú QR","Móvil","Editable"],
   problem:"Cartas de papel que se desgastan y cambian de precio.", solution:"Un menú web que se abre con un QR en la mesa.", result:"Cambias platos y precios al instante, sin reimprimir."},
  {id:"catalogo", name:"Catálogo Completo", title:"Catálogo digital", url:"https://TU-DEMO-CATALOGO.vercel.app", tags:["Catálogo","Pedidos","WhatsApp"],
   problem:"Mostrar productos por fotos sueltas en WhatsApp.", solution:"Un catálogo ordenado por categorías con botón de pedido.", result:"Más pedidos claros y menos preguntas repetidas."}
];;
const SOCIAL = {ig:"https://instagram.com/", tt:"https://tiktok.com/"};
/* ============================ */

const $ = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* Iconos de respaldo: si el CDN de Lucide falla, la página sigue completa. */
const ICONS = {
  check:'<path d="M20 6 9 17l-5-5"/>',
  globe:'<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  'arrow-right':'<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  monitor:'<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  smartphone:'<rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/>',
  maximize:'<path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>',
  moon:'<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  menu:'<path d="M4 12h16"/><path d="M4 6h16"/><path d="M4 18h16"/>',
  x:'<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
  plus:'<path d="M5 12h14"/><path d="M12 5v14"/>',
  'message-circle':'<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  star:'<path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01z"/>',
  'layout-template':'<rect width="18" height="7" x="3" y="3" rx="1"/><rect width="9" height="7" x="3" y="14" rx="1"/><rect width="5" height="7" x="16" y="14" rx="1"/>',
  'shopping-bag':'<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  'qr-code':'<rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3M12 7v3a2 2 0 0 1-2 2H7M16 12h1M12 21v-1"/>',
  'app-window':'<rect x="2" y="4" width="20" height="16" rx="2"/><path d="M10 4v4M2 8h20M6 4v4"/>'
};

function iconSvg(name){
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (ICONS[name] || '') + '</svg>';
}
function waIcon(){
  return '<svg viewBox="0 0 24 24" aria-hidden="true"><use href="#wa-icon"></use></svg>';
}
function fallbackIcons(){
  $$('[data-lucide]').forEach(el => {
    if (el.tagName.toLowerCase() === 'svg') return;
    const body = ICONS[el.getAttribute('data-lucide')];
    if (!body) return;
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');
    if (el.getAttribute('class')) svg.setAttribute('class', el.getAttribute('class'));
    svg.innerHTML = body;
    el.replaceWith(svg);
  });
}
function paintIcons(){
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    try { window.lucide.createIcons(); } catch (e) {}
  }
  fallbackIcons();
}

/* WhatsApp y redes */
const waLink = text => 'https://wa.me/' + WA_NUMBER + '?text=' + encodeURIComponent(text);
$$('[data-wa]').forEach(el => {
  el.setAttribute('href', waLink(el.dataset.wa));
  if (el.tagName === 'A') {
    el.setAttribute('target', '_blank');
    el.setAttribute('rel', 'noopener');
  }
});
if ($('#ig')) $('#ig').href = SOCIAL.ig;
if ($('#tt')) $('#tt').href = SOCIAL.tt;

/* Tema claro / oscuro */
const themeBtn = $('#theme-toggle');
function applyTheme(theme, persist){
  document.documentElement.setAttribute('data-theme', theme);
  themeBtn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
  themeBtn.setAttribute('aria-label', theme === 'dark' ? 'Activar tema claro' : 'Activar tema oscuro');
  const light = $('#favicon-light'), dark = $('#favicon-dark');
  if (light && dark) {
    light.media = theme === 'dark' ? 'not all' : 'all';
    dark.media = theme === 'dark' ? 'all' : 'not all';
  }
  if (persist) {
    try { localStorage.setItem('alisto-theme', theme); } catch (e) {}
  }
}
applyTheme(document.documentElement.getAttribute('data-theme') || 'light', false);
themeBtn.addEventListener('click', () => {
  const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  document.documentElement.classList.add('theme-transition');
  applyTheme(next, true);
  setTimeout(() => document.documentElement.classList.remove('theme-transition'), 350);
});

/* Header y menú móvil */
const header = $('.site-header');
const burger = $('#burger');
const menu = $('#links');
function setMenu(open, returnFocus){
  menu.classList.toggle('open', open);
  burger.setAttribute('aria-expanded', open ? 'true' : 'false');
  burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  if (open) {
    const first = menu.querySelector('a');
    // Espera a que termine el paso a visible para poder enfocar el primer enlace
    if (first) setTimeout(() => { if (menu.classList.contains('open')) first.focus(); }, 60);
  } else if (returnFocus) {
    burger.focus();
  }
}
burger.addEventListener('click', () => setMenu(!menu.classList.contains('open'), false));
$$('#links a').forEach(a => a.addEventListener('click', () => setMenu(false, false)));
document.addEventListener('click', e => {
  if (menu.classList.contains('open') && !header.contains(e.target)) setMenu(false, false);
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && menu.classList.contains('open')) setMenu(false, true);
});
const desktopQuery = window.matchMedia('(min-width: 721px)');
if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', e => { if (e.matches) setMenu(false, false); });

/* WhatsApp flotante */
const fab = $('#fab');
let fabShown = false;
function showFab(){
  if (fabShown) return;
  fabShown = true;
  fab.classList.add('show');
}
setTimeout(showFab, 1500);
let formNear = false;
let footerNear = false;
function fabCollides(){
  if (!document.elementsFromPoint) return false;
  const r = fab.getBoundingClientRect();
  if (!r.width || !r.height) return false;
  const points = [];
  [0.1, 0.5, 0.9].forEach(fx => {
    [0.3, 0.7].forEach(fy => {
      points.push([
        Math.min(window.innerWidth - 1, Math.max(0, r.left + r.width * fx)),
        Math.min(window.innerHeight - 1, Math.max(0, r.top + r.height * fy))
      ]);
    });
  });
  return points.some(([x, y]) => {
    const stack = document.elementsFromPoint(x, y).filter(el => !fab.contains(el));
    return stack.some(el => {
      const hit = el.closest('a,button,input,select,textarea,form,footer,.stats b,.stats small');
      return hit && !fab.contains(hit);
    });
  });
}
function updateFab(){
  const hide = formNear || footerNear || fabCollides();
  fab.classList.toggle('is-hidden', hide);
  if (hide) fab.setAttribute('inert', ''); else fab.removeAttribute('inert');
}
const hideFabIO = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (entry.target.id === 'form') formNear = entry.isIntersecting;
    if (entry.target.tagName === 'FOOTER') footerNear = entry.isIntersecting;
  });
  updateFab();
}, { threshold: .15 });
[$('#form'), document.querySelector('footer')].forEach(el => { if (el) hideFabIO.observe(el); });
let fabTimer = 0;
function queueFabCheck(){
  clearTimeout(fabTimer);
  fabTimer = setTimeout(updateFab, 120);
}
window.addEventListener('scroll', queueFabCheck, { passive: true });
window.addEventListener('resize', queueFabCheck);
setTimeout(updateFab, 1600);

/* Scroll: header y aparición del FAB */
function onScroll(){
  header.classList.toggle('scrolled', window.scrollY > 10);
  if (window.scrollY > 160) showFab();
  if (window.scrollY < 240) {
    $$('.nav-link').forEach(a => a.removeAttribute('aria-current'));
  }
}
window.addEventListener('scroll', onScroll, { passive: true });
onScroll();

/* Nav: sección activa */
const navLinks = $$('.nav-link[href^="#"]');
const navSections = navLinks.map(a => document.querySelector(a.getAttribute('href'))).filter(Boolean);
const sectionIO = new IntersectionObserver(entries => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    navLinks.forEach(a => {
      if (a.getAttribute('href') === '#' + entry.target.id) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  });
}, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
navSections.forEach(section => sectionIO.observe(section));

/* Proyectos: pestañas, demo y detalle */
const tabsEl = $('#tabs');
const frame = $('#frame');
const demo = $('#demo');
const ph = $('#ph');
const detail = $('#detail');
const projectPanel = $('#project-panel');
let projectIndex = 0;

function crossfade(el){
  if (reduceMotion || !el) return;
  if (window.__motionAnimate) {
    window.__motionAnimate(el, { opacity: [0, 1] }, { duration: .3 });
  } else if (el.animate) {
    el.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' });
  }
}
function showPlaceholder(p, message){
  ph.innerHTML = '<div class="ph-inner"><span class="ph-icon">' + iconSvg('monitor') + '</span><p>' + message + '</p><a class="btn btn-blue" href="' + p.url + '" target="_blank" rel="noopener">' + iconSvg('maximize') + 'Abrir demo en nueva pestaña</a></div>';
  ph.style.display = 'grid';
  demo.classList.remove('ok');
}
function renderDetail(p){
  detail.innerHTML =
    '<h3>' + p.title + '</h3>' +
    '<div class="tags">' + p.tags.map(t => '<span>' + t + '</span>').join('') + '</div>' +
    '<h4>El problema</h4><p>' + p.problem + '</p>' +
    '<h4>La solución</h4><p>' + p.solution + '</p>' +
    '<h4>El resultado</h4><p>' + p.result + '</p>' +
    '<a class="btn btn-blue" href="' + p.url + '" target="_blank" rel="noopener">' + iconSvg('maximize') + 'Abrir demo en pantalla completa</a>' +
    '<a class="btn btn-wa" href="' + waLink('Hola, quiero algo similar a: ' + p.title) + '" target="_blank" rel="noopener">' + waIcon() + 'Quiero algo similar</a>';
}
function loadProject(p){
  demo.onload = null;
  demo.onerror = null;
  if (!p.url || /TU-DEMO/i.test(p.url)) {
    demo.src = 'about:blank';
    showPlaceholder(p, 'La demo de este proyecto estará disponible muy pronto.');
    return;
  }
  ph.innerHTML = '<div class="ph-inner"><p>Cargando demo…</p></div>';
  ph.style.display = 'grid';
  demo.classList.remove('ok');
  let settled = false;
  const timer = setTimeout(() => {
    if (settled) return;
    settled = true;
    showPlaceholder(p, 'No pudimos cargar la demo aquí. Ábrela en una pestaña nueva.');
  }, 8000);
  demo.onload = () => {
    if (settled) return;
    settled = true;
    clearTimeout(timer);
    demo.classList.add('ok');
    ph.style.display = 'none';
  };
  demo.onerror = () => {
    if (settled) return;
    settled = true;
    clearTimeout(timer);
    showPlaceholder(p, 'No pudimos cargar la demo aquí. Ábrela en una pestaña nueva.');
  };
  demo.src = p.url;
  demo.title = 'Demo de ' + p.title;
}
function selectProject(i, moveFocus){
  const p = PROJECTS[i];
  if (!p) return;
  projectIndex = i;
  $$('.tab', tabsEl).forEach((tab, j) => {
    const on = j === i;
    tab.setAttribute('aria-selected', on ? 'true' : 'false');
    tab.tabIndex = on ? 0 : -1;
    if (on) projectPanel.setAttribute('aria-labelledby', tab.id);
  });
  renderDetail(p);
  loadProject(p);
  crossfade(detail);
  crossfade(frame);
  if (moveFocus) tabsEl.children[i].focus();
}
PROJECTS.forEach((p, i) => {
  const tab = document.createElement('button');
  tab.type = 'button';
  tab.className = 'tab';
  tab.id = 'tab-' + p.id;
  tab.setAttribute('role', 'tab');
  tab.setAttribute('aria-selected', 'false');
  tab.setAttribute('aria-controls', 'project-panel');
  tab.tabIndex = -1;
  tab.textContent = p.name;
  tab.addEventListener('click', () => selectProject(i, false));
  tab.addEventListener('keydown', e => {
    let next = null;
    if (e.key === 'ArrowRight') next = (i + 1) % PROJECTS.length;
    if (e.key === 'ArrowLeft') next = (i - 1 + PROJECTS.length) % PROJECTS.length;
    if (e.key === 'Home') next = 0;
    if (e.key === 'End') next = PROJECTS.length - 1;
    if (next !== null) {
      e.preventDefault();
      selectProject(next, true);
    }
  });
  tabsEl.append(tab);
});
selectProject(0, false);

/* Selector escritorio / móvil */
$$('.seg button').forEach(btn => {
  btn.addEventListener('click', () => {
    $$('.seg button').forEach(b => {
      const on = b === btn;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    frame.classList.toggle('mobile', btn.dataset.dev === 'mobile');
  });
});

/* Proceso: secuencia automática de 4 pasos */
const stepsEl = $('#steps');
const steps = $$('.step', stepsEl);
let stepIndex = 0;
let stepPaused = false;
let stepVisible = false;
let stepManual = false;
let stepTimer = null;
function setStep(i){
  stepIndex = i;
  steps.forEach((step, j) => {
    const on = j === i;
    step.classList.toggle('active', on);
    if (on) step.setAttribute('aria-current', 'step');
    else step.removeAttribute('aria-current');
  });
  stepsEl.style.setProperty('--p', String((i + 1) / steps.length));
}
function startSteps(){
  if (stepTimer || reduceMotion || stepManual) return;
  stepTimer = setInterval(() => {
    if (!stepPaused && stepVisible) setStep((stepIndex + 1) % steps.length);
  }, 2500);
}
function stopSteps(){
  if (stepTimer) { clearInterval(stepTimer); stepTimer = null; }
}
setStep(0);
const stepsIO = new IntersectionObserver(entries => {
  stepVisible = entries[0].isIntersecting;
  if (stepVisible) startSteps(); else stopSteps();
}, { threshold: .2 });
stepsIO.observe(stepsEl);
stepsEl.addEventListener('mouseenter', () => { stepPaused = true; });
stepsEl.addEventListener('mouseleave', () => { stepPaused = false; });
stepsEl.addEventListener('focusin', () => { stepPaused = true; });
stepsEl.addEventListener('focusout', () => { stepPaused = false; });
stepsEl.addEventListener('touchstart', () => {
  stepPaused = true;
  setTimeout(() => { stepPaused = false; }, 4000);
}, { passive: true });
steps.forEach((step, i) => {
  step.addEventListener('click', () => {
    setStep(i);
    stepManual = true;
    stopSteps();
  });
});

/* FAQ: acordeón accesible, una abierta a la vez */
const faqItems = $$('.faq-item');
function setFaq(item, open){
  const btn = item.querySelector('.faq-btn');
  const panel = item.querySelector('.faq-panel');
  btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  panel.dataset.open = open ? 'true' : 'false';
  panel.setAttribute('aria-hidden', open ? 'false' : 'true');
  if (open) panel.removeAttribute('inert');
  else panel.setAttribute('inert', '');
}
faqItems.forEach((item, index) => {
  const btn = item.querySelector('.faq-btn');
  btn.addEventListener('click', () => {
    const willOpen = btn.getAttribute('aria-expanded') !== 'true';
    faqItems.forEach(other => { if (other !== item) setFaq(other, false); });
    setFaq(item, willOpen);
  });
  btn.addEventListener('keydown', e => {
    let next = null;
    if (e.key === 'ArrowDown') next = (index + 1) % faqItems.length;
    if (e.key === 'ArrowUp') next = (index - 1 + faqItems.length) % faqItems.length;
    if (e.key === 'Home') next = 0;
    if (e.key === 'End') next = faqItems.length - 1;
    if (next !== null) {
      e.preventDefault();
      faqItems[next].querySelector('.faq-btn').focus();
    }
  });
});
faqItems.forEach((item, i) => setFaq(item, i === 0));

/* Formulario: validación y mensaje de WhatsApp */
const form = $('#form');
const fName = $('#f-name');
const fType = $('#f-type');
const fOther = $('#f-other');
const fNeed = $('#f-need');
const otherField = $('#other-field');
const otherInner = $('#other-inner');
function setFieldError(input, message){
  const field = input.closest('.field');
  if (!field) return;
  field.classList.add('invalid');
  input.setAttribute('aria-invalid', 'true');
  const err = field.querySelector('.err');
  if (err) err.textContent = message;
}
function clearFieldError(input){
  const field = input.closest('.field');
  if (!field) return;
  field.classList.remove('invalid');
  input.setAttribute('aria-invalid', 'false');
  const err = field.querySelector('.err');
  if (err) err.textContent = '';
}
function syncOther(){
  const on = fType.value === 'Otro';
  otherField.dataset.open = on ? 'true' : 'false';
  otherField.setAttribute('aria-hidden', on ? 'false' : 'true');
  if (on) otherInner.removeAttribute('inert');
  else {
    otherInner.setAttribute('inert', '');
    fOther.value = '';
    clearFieldError(fOther);
  }
}
fType.addEventListener('change', () => { syncOther(); clearFieldError(fType); });
fName.addEventListener('input', () => clearFieldError(fName));
fOther.addEventListener('input', () => clearFieldError(fOther));
syncOther();
form.addEventListener('submit', e => {
  e.preventDefault();
  let firstInvalid = null;
  const name = fName.value.trim();
  if (!name) {
    setFieldError(fName, 'Escribe tu nombre para saber cómo llamarte.');
    firstInvalid = firstInvalid || fName;
  }
  if (!fType.value) {
    setFieldError(fType, 'Elige el tipo de negocio.');
    firstInvalid = firstInvalid || fType;
  }
  let typeLabel = fType.value;
  if (fType.value === 'Otro') {
    const other = fOther.value.trim();
    if (!other) {
      setFieldError(fOther, 'Cuéntame cuál es tu negocio.');
      firstInvalid = firstInvalid || fOther;
    } else {
      typeLabel = other;
    }
  }
  if (firstInvalid) {
    firstInvalid.focus();
    firstInvalid.scrollIntoView({ block: 'center', behavior: reduceMotion ? 'auto' : 'smooth' });
    return;
  }
  const need = fNeed.value.trim() || 'un servicio digital';
  const message = 'Hola, soy ' + name + '. Mi negocio: ' + typeLabel + '. Necesito: ' + need + '.';
  window.open(waLink(message), '_blank', 'noopener');
});

/* Lucide: se pinta cuando el script diferido ya está listo */
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', paintIcons);
else paintIcons();
</script>

<script nomodule>document.documentElement.classList.remove('js-motion');</script>
<script type="module">
/* Motion: entrada al hacer scroll y crossfade. Si falla, todo queda visible. */
const root = document.documentElement;
const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
if (reduce) {
  root.classList.remove('js-motion');
} else {
  const fallback = setTimeout(() => {
    if (!root.classList.contains('motion-ready')) root.classList.remove('js-motion');
  }, 4000);
  try {
    const { animate, inView } = await import('https://cdn.jsdelivr.net/npm/motion@14.9.0/+esm');
    clearTimeout(fallback);
    window.__motionAnimate = animate;
    const items = Array.from(document.querySelectorAll('.rv'));
    const revealed = new WeakSet();
    items.forEach(el => {
      const siblings = el.parentElement ? Array.from(el.parentElement.children).filter(c => c.classList.contains('rv')) : [];
      const index = Math.max(0, siblings.indexOf(el));
      inView(el, () => {
        if (revealed.has(el)) return;
        revealed.add(el);
        animate(el, { opacity: [0, 1], transform: ['translateY(24px)', 'translateY(0px)'] }, { duration: .5, delay: index * .08 });
      }, { amount: .15 });
    });
    root.classList.add('motion-ready');
  } catch (e) {
    clearTimeout(fallback);
    root.classList.remove('js-motion');
  }
}
</script>
</body>
</html>
