<main id="main">
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div>
      <span class="pill">Disponible para nuevos proyectos</span>
      <h1 id="hero-title">Tu negocio online, <em>listo en días.</em></h1>
      <p class="lead">Landing pages, catálogos digitales, menús QR y microapps que tú mismo puedes editar. Profesional, rápido y sin costos escondidos.</p>
      <div class="ctas">
        <a class="btn btn-blue" href="#proyectos">Ver proyectos en vivo <i data-lucide="arrow-right" aria-hidden="true"></i></a>
        <a class="btn btn-ghost" data-wa="Hola, quiero cotizar una página para mi negocio." href="#contacto">Cotizar por WhatsApp</a>
      </div>
      <div class="trust">
        <span><i data-lucide="check" aria-hidden="true"></i>Entrega en 3–7 días</span>
        <span><i data-lucide="check" aria-hidden="true"></i>Editas tus precios</span>
        <span><i data-lucide="check" aria-hidden="true"></i>Dominio a tu nombre</span>
      </div>
    </div>
    <div class="visual" aria-hidden="true">
      <div class="mock vis-main">
        <div class="bar"><b></b><b></b><b></b><span>tumarca.com/demo</span></div>
        <div class="mk">
          <div class="mk-nav"><span class="mk-brand">La Candelaria</span><span class="mk-links"><span>Menú</span><span>Reservas</span></span><span>Reservar</span></div>
          <div class="mk-hero"><span class="mk-kicker">Cocina peruana</span><h3>Sabor de barrio, servido al día.</h3><span class="mk-cta">Ver menú</span></div>
          <div class="mk-grid">
            <div class="mk-item"><div class="mk-thumb"></div><b>Ceviche clásico</b><span>S/ 32</span></div>
            <div class="mk-item"><div class="mk-thumb"></div><b>Lomo saltado</b><span>S/ 28</span></div>
            <div class="mk-item"><div class="mk-thumb"></div><b>Chicha morada</b><span>S/ 8</span></div>
          </div>
        </div>
      </div>
      <div class="phone">
        <div class="mk">
          <div class="mk-nav"><span class="mk-brand">Menú QR</span></div>
          <div class="mk-hero"><span class="mk-kicker">Carta del día</span><h3>Elige y pide en un toque.</h3><span class="mk-cta">Pedir</span></div>
          <div class="mk-grid">
            <div class="mk-item"><div class="mk-thumb"></div><div><b>Ceviche</b><span>S/ 32</span></div></div>
            <div class="mk-item"><div class="mk-thumb"></div><div><b>Lomo</b><span>S/ 28</span></div></div>
          </div>
        </div>
      </div>
      <div class="chip r"><span class="chip-stars"><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i><i data-lucide="star"></i></span><b>5.0</b></div>
      <div class="chip w"><span class="chip-ico"><i data-lucide="message-circle"></i></span><div><b>Nuevo pedido</b><small>llegó por WhatsApp</small></div></div>
    </div>
  </div>
</section>

<div class="stats">
  <div class="wrap">
